    <!-- Shredder -->
    <string name="shred_title">Shredder</string>
    <string name="shred_desc">Overwrite-then-delete: 3 passes (zeros, ones, random) with fsync, then rename &amp; unlink.</string>
    <string name="shred_note">Note: on flash storage (F2FS/ext4 journaling) no userspace tool can guarantee physical NAND erasure. This is as permanent as Android allows.</string>
    <string name="shred_confirm_title">Shred permanently?</string>
    <string name="shred_confirm_file">"%1$s" will be overwritten 3 times and deleted. This cannot be undone.</string>
    <string name="shred_confirm_folder">Every file inside "%1$s" will be overwritten 3 times and deleted. This cannot be undone.</string>
